{
  "name": "@jiplabs/core",
  "version": "1.2.0",
  "private": false,
  "description": "Governance kernel for governed autonomous systems — authority, policy, evidence, decisions, execution authorization, audit, rollback, durable recovery, evaluation corpus and component governance.",
  "license": "MIT",
  "author": "JipLabs LLC",
  "homepage": "https://jiplabs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JipLabs/jiplabs-core.git",
    "directory": "packages/jiplabs-core"
  },
  "bugs": {
    "url": "https://github.com/JipLabs/jiplabs-core/issues"
  },
  "keywords": [
    "governance",
    "autonomous-systems",
    "policy",
    "authority",
    "evidence",
    "decisions",
    "rollback",
    "audit",
    "evaluation",
    "regression",
    "component-governance",
    "jiplabs"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./experimental": {
      "types": "./dist/experimental.d.ts",
      "import": "./dist/experimental.js",
      "default": "./dist/experimental.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  }
}
